# Public site URL. Used for canonical links, hreflang and the sitemap.
NEXT_PUBLIC_SITE_URL=https://edu-development.org

# --- Org contact details ---------------------------------------------------
# Nothing personal ships in the source. Every value below renders as a visible
# [BRACKETS] placeholder until it is set, and scripts/check-placeholders.mjs
# lists anything still open. The phone/email appear on the header, footer,
# contact page, error page and structured data; the three named contacts are
# the people listed on the Contact page, one set per row.
#
# NEXT_PUBLIC_SITE_PHONE_DISPLAY=+251 911 218 169
# NEXT_PUBLIC_SITE_PHONE_TEL=+251911218169
# NEXT_PUBLIC_SITE_EMAIL=info@edu-development.org
#
# NEXT_PUBLIC_CONTACT_0_NAME=Guta Abdi
# NEXT_PUBLIC_CONTACT_0_PHONE_DISPLAY=+251 911 218 169
# NEXT_PUBLIC_CONTACT_0_PHONE_TEL=+251911218169
# NEXT_PUBLIC_CONTACT_0_EMAIL=info@edu-development.org
# NEXT_PUBLIC_CONTACT_1_NAME=Dechassa Sisay
# NEXT_PUBLIC_CONTACT_1_PHONE_DISPLAY=+251 912 457 529
# NEXT_PUBLIC_CONTACT_1_PHONE_TEL=+251912457529
# NEXT_PUBLIC_CONTACT_1_EMAIL=programs@edu-development.org
# NEXT_PUBLIC_CONTACT_2_NAME=Tucho Enkossa
# NEXT_PUBLIC_CONTACT_2_PHONE_DISPLAY=+251 911 962 639
# NEXT_PUBLIC_CONTACT_2_PHONE_TEL=+251911962639
# NEXT_PUBLIC_CONTACT_2_EMAIL=info@edu-development.org

# --- Contact form delivery -------------------------------------------------
# Pick ONE backend. With none set, the form still works end to end and the
# message is logged with a warning instead of being delivered.

# Option A (default once provisioned): Neon Postgres + the admin inbox at
# /admin. DATABASE_URL is injected automatically by the Neon integration -
# never set it by hand.
#   vercel integration add neon
#   vercel env pull .env.local --yes
#   node --env-file=.env.local scripts/db-init.mjs
#
# Salts the IP address stored with each message (see lib/ip.ts). Any random
# string; changing it later just stops matching old hashes to new ones.
# IP_HASH_SALT=
#
# Resend, for the "new message" notification email. The shared onboarding
# address only delivers to the Resend account's own email until a sending
# domain is verified.
# RESEND_API_KEY=
# RESEND_FROM="EFDA Site <onboarding@resend.dev>"

# Where notifications go. Point at the Program Manager until EFDA has a role
# inbox on its own domain. Used by both Option A (Resend) and Option B
# (Firestore) below.
# CONTACT_NOTIFY_TO=

# Option B: Firestore + the Trigger Email extension.
# Requires `npm install firebase-admin`.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option C: Formspree.
# FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx

# --- Admin (/admin) ---------------------------------------------------------
# One shared password, no user accounts. ADMIN_SESSION_SECRET signs the
# session cookie - any long random string, e.g. `openssl rand -hex 32`.
# ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=

# --- Spam ------------------------------------------------------------------
# Cloudflare Turnstile. These two are ONE SWITCH - set both or neither.
#
# The public key makes the browser render the widget and produce a token; the
# secret lets the server check it. Setting only one leaves spam protection OFF
# and logs an error on every submission, rather than rejecting enquiries the
# browser had no way to get a token for.
#
# Cloudflare's published always-passes test pair, for local checks:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Analytics -------------------------------------------------------------
# Cookie-free, so no consent banner. Set ONE; leave both unset and nothing is
# loaded at all.
# NEXT_PUBLIC_CF_BEACON_TOKEN=      # Cloudflare Web Analytics
# NEXT_PUBLIC_VERCEL_ANALYTICS=1    # Vercel Web Analytics
